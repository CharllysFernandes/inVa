{
  "manifest_version": 3,
  "name": "inVa",
  "version": "0.0.1",
  "description": "Extensão para Chrome/Edge",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/favicon-32x32.png",
      "48": "assets/icons/favicon-32x32.png",
      "128": "assets/icons/apple-touch-icon.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/content.js"
      ]
    }
  ],
  "permissions": [
    "activeTab"
  ],
  "icons": {
    "16": "assets/icons/favicon-32x32.png",
    "48": "assets/icons/favicon-32x32.png",
    "128": "assets/icons/apple-touch-icon.png"
  }
}